# Copy to .env. Secrets are read only by backend; never put keys in browser storage.
MEET_DATA_DIR=.local
MEET_EXTENSION_ID=replace_with_unpacked_extension_id
MEET_PROVIDER_URL=https://api.deepseek.com
MEET_PROVIDER_MODEL=deepseek-flash
# Set securely through Settings for this run, or environment:
# DEEPSEEK_API_KEY=
